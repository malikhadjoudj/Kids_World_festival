generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Pack {
  id              String     @id
  name            String
  description     String?
  price           Float
  perSquareMeter  Boolean    @default(false)
  surface         String?
  icon            String?
  exposants       Exposant[]
}

model Stand {
  id              String     @id
  status          String     @default("disponible") // disponible, reserve, bloque
  packCompatible  String
  surface         Float
  x               Float?
  y               Float?
  exposants       Exposant[]
}

model Exposant {
  id                   String   @id @default(uuid())
  nomPrenom            String
  fonction             String
  raisonSociale        String
  adresse              String
  tel                  String
  contact              String
  email                String
  rc                   String
  nif                  String
  art                  String
  nis                  String
  activite             String
  
  // Relation to Pack
  packId               String
  pack                 Pack     @relation(fields: [packId], references: [id])
  selectedPackIds      String   @default("")
  
  surface              Int?
  
  // Billing
  totalHT              Float
  tva                  Float
  totalTTC             Float
  
  statutContrat        String   @default("en_attente") // en_attente, recu, incomplet
  
  // Documents
  hasUploadedDocuments Boolean  @default(false)
  documentUrl          String?

  // Document step 1 (surface + tarification)
  documentTarificationNomPrenom String?
  documentTarificationFonction String?
  documentTarificationRaisonSociale String?
  documentTarificationAdresse String?
  documentTarificationTel String?
  documentTarificationContact String?
  documentTarificationEmail String?
  documentTarificationRc String?
  documentTarificationNif String?
  documentTarificationArt String?
  documentTarificationNis String?
  documentTarificationActivite String?

  // Document step 2 (conditions de participation)
  documentParticipationNomPrenom String?
  documentParticipationEntreprise String?
  
  // Relation to Stand
  standId              String?
  stand                Stand?   @relation(fields: [standId], references: [id])
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
